# Example env for docker-compose-odoo.yml. Copy to .env.odoo and run:
#   docker compose -f docker-compose-odoo.yml --env-file .env.odoo up -d
# Or export variables and run without --env-file.

# Host
SERVER_SCHEME=http
HOST_NAME=localhost
ODOO_HOSTNAME=${HOST_NAME}:8069

# Postgres (Odoo DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DATADIR=postgresql-data

# MySQL (EIP management DB + optional shared OpenMRS host for EIP)
# EIP requires database openmrs_eip_mgt_odoo (Liquibase). On an EXISTING mysql-data volume,
# run odoo-docker/mysql-init/01-eip-databases.sql once as root (initdb.d only runs on first boot).
MYSQL_ROOT_PASSWORD=password
MYSQL_PORT=3306
MYSQL_DATADIR=mysql-data

# Odoo
ODOO_DATABASE=odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=password
ODOO_USER=admin
ODOO_PASSWORD=admin
ODOO_PUBLIC_PORT=8069
ODOO_ADDONS=sale_management,stock,account_account,purchase,mrp,odoo_initializer,mrp_product_expiry,product_expiry,l10n_generic_coa
ODOO_FILESTORE=odoo-filestore
ODOO_CONFIG_PATH=odoo-config
ODOO_CONFIG_CHECKSUMS_PATH=odoo-checksums
ODOO_EXTRA_ADDONS=odoo-extra-addons

# FHIR Odoo
FHIR_ODOO_PUBLIC_PORT=8083
EIP_ODOO_DRUGS_CATEGORY_EXT_ID=categ_products_drug_orders

# EIP Odoo–OpenMRS (when running with O3-amrs backend)
EIP_DB_NAME_ODOO=openmrs_eip_mgt_odoo
EIP_DB_USER_ODOO=openmrs_eip_mgt_odoo
EIP_DB_PASSWORD_ODOO=password
OPENMRS_URL=http://backend:8080/openmrs
OPENMRS_DB_HOST=db
OPENMRS_DB_PORT=3306
OPENMRS_DB_NAME=amrs
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=openmrs
OPENMRS_USER=admin
OPENMRS_PASSWORD=Admin123
EIP_FHIR_SERVER_URL=http://backend:8080/openmrs/ws/fhir2/R4
EIP_ODOO_FHIR_SERVER_URL=http://fhir-odoo:8080/odoo/fhir/R4
EIP_PRODUCT_SYNC_INITIAL_DELAY=60000
EIP_PRODUCT_SYNC_DELAY=86400000

# Optional: override Odoo/Postgres/EIP images
# Defaults: o3-amrs-odoo-postgres, o3-amrs-odoo, o3-amrs-eip-odoo-openmrs-ampath (full Ozone + synthetic ServiceRequest for extra order types)
# ODOO_POSTGRES_IMAGE=ghcr.io/ampath/o3-amrs-odoo-postgres:3.6.0
# ODOO_IMAGE=ghcr.io/ampath/o3-amrs-odoo:3.6.0
# EIP_ODOO_OPENMRS_IMAGE=ghcr.io/ampath/o3-amrs-eip-odoo-openmrs-ampath:3.6.0
# Stock Ozone-only EIP (no AMPATH synthetic path): ghcr.io/ampath/o3-amrs-eip-odoo-openmrs:3.6.0

# Order types processed via OpenMRS REST + synthetic ServiceRequest (replaces former eip-odoo-ampath)
# EIP_ORDER_TYPE_UUIDS=uuid1,uuid2,uuid3

# Odoo partner display name: "Given Family (identifier)" using preferred FHIR identifier (USUAL → OFFICIAL → first)
# EIP_ODOO_PARTNER_APPEND_IDENTIFIER_TO_NAME=true

# Distro / env-substitution (path to files for env-substitution)
DISTRO_PATH=.

# EIP client → MedicationDispense stock sync (Odoo inventory HTTP API)
# Old sale-order path used direct:odoo-event-listener (no longer registered).
DB_EVENT_DESTINATIONS_ODOO=direct:medication-dispense-to-stock
EIP_WATCHED_TABLES=medication_dispense
EIP_FHIR_RESOURCES=
EIP_ORDER_TYPE_UUIDS=
ODOO_OPENMRS_ENABLE_PATIENT_SYNC=false
EIP_PRODUCT_SYNC_ENABLED=false
CREATE_CUSTOMER_IF_NOT_EXIST=false
ODOO_CUSTOMER_EXTERNAL_ID=comment
ODOO_CUSTOMER_DOB_FIELD=
ODOO_CUSTOMER_WEIGHT_FIELD=
EMR_WEIGHT_CONCEPT=
ODOO_ENABLE_EXTRA_CUSTOMER_FIELDS_ROUTE=false
ODOO_ENABLE_EXTRA_QUOTATION_FIELDS_ROUTE=false

# HIE product catalogue sync (EIP Camel timer → OpenMRS + Odoo). Default off until auth/env ready.
# EIP_HIE_PRODUCT_SYNC_ENABLED=true
# EIP_HIE_PRODUCT_SYNC_DELAY=86400000
# EIP_HIE_PRODUCT_SYNC_INITIAL_DELAY=60000
# EIP_HIE_PRODUCT_SYNC_MAX_PAGES=0
# HIE_AUTH_URL=
# HIE_CLIENT_ID=
# HIE_CLIENT_SECRET=
# HIE_GRANT_TYPE=client_credentials
# HIE_BASE_URL=
# HIE_TEST_BEARER_TOKEN=
# HIE_PRODUCT_CATALOGUE_CONCEPT_SOURCE_NAME=HIE Product Catalogue
# HIE_PRODUCT_CATALOGUE_DRUG_CONCEPT_SET_UUID=2b52fc85-b59f-5e7f-a47d-d83863ac791f
# HIE_PRODUCT_CATALOGUE_DISPENSING_UNITS_CONCEPT_SET_UUID=0c9a8c3e-3220-553d-8111-9cbe021aafc7

# AMPATH ETL claims (submit-claim-odoo): optional; overrides unset ir.config_parameter keys
# AMPATH_ETL_CLAIMS_SUBMIT_URL=
# AMPATH_ETL_CLAIMS_API_KEY=your-key-here
