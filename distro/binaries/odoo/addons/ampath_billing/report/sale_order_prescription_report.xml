<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ported from Transcare health_care: wizard-only report + prescription_lines from Python. -->
    <record id="paperformat_ampath_prescription" model="report.paperformat">
        <field name="name">AMPATH Prescription</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sale_order_prescription" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ampath_billing.report_sale_order_prescription_document</field>
        <field name="report_file">ampath_billing.report_sale_order_prescription_document</field>
        <field name="print_report_name">'Prescription - %s' % (object.name)</field>
        <!-- Only via "Print prescription" wizard (same as health_care) -->
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="ampath_billing.paperformat_ampath_prescription"/>
    </record>

    <template id="report_sale_order_prescription_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mt-0">Prescription</h2>
                        <p class="text-muted mb-2">
                            <span t-field="o.company_id.name"/>
                            <t t-if="o.partner_id"> — <span t-field="o.partner_id"/></t>
                        </p>
                        <div class="row small mb-3" t-if="o.x_patient_uuid or o.x_external_identifier or o.x_customer_dob">
                            <div class="col-12">
                                <t t-if="o.x_external_identifier">
                                    <span>ID: </span><span t-field="o.x_external_identifier"/><span> · </span>
                                </t>
                                <t t-if="o.x_customer_dob">
                                    <span>DOB: </span><span t-field="o.x_customer_dob"/><span> · </span>
                                </t>
                                <t t-if="o.x_patient_gender">
                                    <span t-field="o.x_patient_gender"/>
                                </t>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table table-bordered">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th>UoM</th>
                                    <th>Strength</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="prescription_lines[o.id]" t-as="line">
                                    <tr>
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                        <td><span t-field="line.product_uom"/></td>
                                        <td>
                                            <span t-if="line.product_id.x_drug_strength" t-field="line.product_id.x_drug_strength"/>
                                            <span t-else="" class="text-muted">—</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
