<odoo>
    <data>
        <record id="view_ampath_claim_submit_result_form" model="ir.ui.view">
            <field name="name">ampath.billing.claim.submit.result.form</field>
            <field name="model">ampath.billing.claim.submit.result</field>
            <field name="arch" type="xml">
                <form string="Claim sent">
                    <sheet>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="headline" readonly="1" nolabel="1" colspan="2"/>
                        </group>
                        <field name="response_full" invisible="1"/>
                    </sheet>
                    <footer>
                        <button special="cancel" string="Close" class="btn-primary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
