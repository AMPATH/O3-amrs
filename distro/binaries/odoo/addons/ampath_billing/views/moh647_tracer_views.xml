<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_moh647_tracer_tree" model="ir.ui.view">
        <field name="name">ampath.moh647.tracer.tree</field>
        <field name="model">ampath.moh647.tracer</field>
        <field name="arch" type="xml">
            <tree editable="bottom" multi_edit="1">
                <field name="sequence" width="50px"/>
                <field name="section" width="120px"/>
                <field name="name" width="280px"/>
                <field name="unit_of_issue" width="90px"/>
                <field
                    name="product_ids"
                    widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}"
                    width="320px"
                />
                <field
                    name="related_product_ids"
                    widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}"
                    readonly="1"
                    width="320px"
                />
                <field name="has_related_products" column_invisible="1"/>
                <button
                    name="action_apply_related_products"
                    type="object"
                    string="Apply related"
                    class="btn-link"
                    invisible="not has_related_products"
                />
                <field name="is_mapped" width="70px"/>
                <field name="active" width="50px" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_moh647_tracer_form" model="ir.ui.view">
        <field name="name">ampath.moh647.tracer.form</field>
        <field name="model">ampath.moh647.tracer</field>
        <field name="arch" type="xml">
            <form string="MOH 647 Tracer">
                <header>
                    <button
                        name="action_apply_related_products"
                        type="object"
                        string="Apply related drugs"
                        class="btn-primary"
                        invisible="not has_related_products"
                    />
                    <field name="has_related_products" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence" class="oe_inline"/> .
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="section"/>
                            <field name="unit_of_issue"/>
                            <field name="is_mapped"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Mapped products" col="1">
                        <field
                            name="product_ids"
                            widget="many2many_tags"
                            options="{'no_create': True, 'no_create_edit': True}"
                            nolabel="1"
                            class="w-100"
                        />
                        <field name="product_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field
                                    name="product_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    width="500px"
                                />
                                <field name="uom_id" width="140px"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Related drugs (same GE)" col="1">
                        <div class="text-muted mb-2" colspan="2">
                            After you map one product with a GE / concept code, siblings appear here.
                            New catalogue SKUs for that GE show up automatically — use Apply related drugs.
                        </div>
                        <field
                            name="related_product_ids"
                            widget="many2many_tags"
                            options="{'no_create': True, 'no_create_edit': True}"
                            readonly="1"
                            nolabel="1"
                            class="w-100"
                        />
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="is_mapped">
                        Unmapped — report columns A–J will show "-" until at least one product is linked.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_moh647_tracer_search" model="ir.ui.view">
        <field name="name">ampath.moh647.tracer.search</field>
        <field name="model">ampath.moh647.tracer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sequence"/>
                <field name="section"/>
                <field name="product_ids"/>
                <filter name="unmapped" string="Unmapped (−)" domain="[('is_mapped', '=', False)]"/>
                <filter name="mapped" string="Mapped" domain="[('is_mapped', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_section" string="Section" context="{'group_by': 'section'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_moh647_tracer" model="ir.actions.act_window">
        <field name="name">MOH 647 Tracer Mapping</field>
        <field name="res_model">ampath.moh647.tracer</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_moh647_tracer_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Map each of the 85 MOH 647 tracers to one or more Odoo products.
            </p>
            <p>
                Map one product, then use <strong>Apply related</strong> to add other packages
                that share the same GE code. Unmapped tracers print "-" on the report.
            </p>
        </field>
    </record>
</odoo>
