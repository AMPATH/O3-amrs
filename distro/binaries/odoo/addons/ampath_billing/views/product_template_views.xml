<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_sha_intervention" model="ir.ui.view">
        <field name="name">product.template.form.sha.intervention</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//field[@name='categ_id']" position="after">
                <field name="x_concept_source"/>
                <field name="x_concept_code"/>
                <field name="x_drug_strength"/>
                <field name="x_intervention_code"/>
            </xpath>
        </field>
    </record>
    <record id="product_variant_form_view_sha_intervention" model="ir.ui.view">
        <field name="name">product.product.form.sha.intervention</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//field[@name='categ_id']" position="after">
                <field name="x_concept_source"/>
                <field name="x_concept_code"/>
                <field name="x_drug_strength"/>
                <field name="x_intervention_code"/>
            </xpath>
        </field>
    </record>
</odoo>
