<odoo>
    <data>
        <record id="view_order_form_ampath_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.ampath</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='partner_id']" position="after">
                    <group string="Visit billing" name="ampath_visit_billing" colspan="2">
                        <field name="x_payment_method"/>
                        <field name="x_insurance_scheme"/>
                        <field name="x_openmrs_encounter_uuid" readonly="1"/>
                        <field name="x_preauth_status" readonly="1"/>
                        <field name="x_preauth_code" readonly="1"/>
                        <field name="x_preauth_request_id" readonly="1"/>
                        <field name="x_preauth_fhir_claim_id" readonly="1"/>
                    </group>
                    <group string="SHA / HIE (quotation claim data)" name="ampath_sha_claim" colspan="2">
                        <field name="x_sha_client_registry_id"/>
                        <field name="x_sha_facility_id"/>
                        <field name="x_sha_facility_name"/>
                        <field name="x_sha_facility_level"/>
                        <field name="x_coverage_id"/>
                        <field name="x_scheme_category_code"/>
                        <field name="x_scheme_category_name"/>
                        <field name="x_claim_type"/>
                        <field name="x_claim_sub_type"/>
                        <field name="x_priority_code"/>
                        <field name="x_claim_practitioner_id"/>
                        <field name="x_patient_gender"/>
                        <field name="x_claim_diagnoses_json" widget="text" placeholder='[{"code":"ICD11","display":"Label"}]'/>
                    </group>
                    <group string="SHIF / payloads (preview only)" name="ampath_preauth_actions">
                        <button name="action_request_preauth" type="object"
                                string="Preview pre-auth payload (JSON)"
                                class="btn-secondary"
                                invisible="state in ('done', 'cancel')"/>
                        <button name="action_pay_cash_clear_shif" type="object"
                                string="Switch to cash (clear SHIF)"
                                class="btn-link"
                                confirm="Clear insurance scheme and pre-auth fields and set payment to CASH?"
                                invisible="state in ('done', 'cancel')"/>
                    </group>
                </xpath>

                <!-- Bulk action buttons above the order lines -->
                <xpath expr="//field[@name='order_line']" position="before">
                    <field name="billing_actions_visible" invisible="1"/>
                    <field name="has_claim_eligible_lines" invisible="1"/>
                    <div class="d-flex gap-2 mb-2 align-items-center"
                         invisible="not billing_actions_visible">
                        <span class="text-muted small me-1">Selected lines:</span>
                        <button name="action_waive_selected" type="object"
                                string="🏷️ Waive" class="btn-warning btn-sm"
                                confirm="Apply 100%% discount to all checked lines?"/>
                        <button name="action_claim_selected" type="object"
                                string="📋 Preview claim JSON" class="btn-info btn-sm"
                                invisible="not has_claim_eligible_lines"
                                confirm="Generate the FHIR claim bundle from checked lines and show JSON?"/>
                        <button name="action_invoice_selected" type="object"
                                string="🧾 Invoice selected" class="btn-primary btn-sm"
                                confirm="Create a partial invoice for all checked lines?"/>
                    </div>
                </xpath>

                <!-- Row styling: muted+green = paid; blue = invoiced but unpaid -->
                <xpath expr="//field[@name='order_line']/tree" position="attributes">
                    <attribute name="decoration-muted">is_line_locked</attribute>
                    <attribute name="decoration-success">ampath_line_invoice_status == 'paid'</attribute>
                    <attribute name="decoration-info">ampath_line_invoice_status == 'invoiced'</attribute>
                </xpath>

                <!-- Extra columns added to the order lines tree -->
                <xpath expr="//field[@name='order_line']/tree" position="inside">

                    <!-- Hidden state fields used in expressions/readonly conditions -->
                    <field name="is_line_locked" column_invisible="1"/>
                    <field name="ampath_line_invoice_status" column_invisible="1"/>
                    <!-- is_downpayment must be explicitly loaded for the readonly expr below -->
                    <field name="is_downpayment" column_invisible="1"/>

                    <!-- Checkbox for bulk actions; readonly on DP/locked lines -->
                    <field name="selected"
                           widget="boolean_toggle"
                           optional="show"
                           readonly="is_downpayment or is_line_locked"/>

                    <!-- Per-line quick-invoice button (single line, no checkbox needed) -->
                    <button name="action_invoice_this_line"
                            type="object"
                            icon="fa-file-text-o"
                            title="Invoice this line"
                            class="btn-sm btn-link text-primary"
                            invisible="ampath_line_invoice_status != 'to_invoice' or is_downpayment"/>

                    <!-- Invoice status icon: blank / 📄 / ✅ -->
                    <field name="invoice_indicator" string="Inv." readonly="1" optional="show"/>

                    <field name="is_claim_eligible" optional="show" readonly="1"/>
                    <field name="x_intervention_code" optional="hide"/>
                    <field name="x_service_date_start" optional="hide"/>
                    <field name="x_service_date_end" optional="hide"/>
                    <field name="insurance_provider_id" optional="show"/>
                    <field name="claim_status" widget="badge" optional="show"
                           decoration-info="claim_status == 'submitted'"
                           decoration-success="claim_status == 'approved'"/>

                </xpath>

                <!-- Lock price/qty/discount when the line's invoice is paid -->
                <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']"
                       position="attributes">
                    <attribute name="readonly">is_line_locked</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']"
                       position="attributes">
                    <attribute name="readonly">is_line_locked</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree//field[@name='discount']"
                       position="attributes">
                    <attribute name="readonly">is_line_locked</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
