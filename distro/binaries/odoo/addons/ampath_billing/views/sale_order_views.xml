<odoo>
    <data>
        <record id="view_order_form_ampath_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.ampath</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- Fields used in header / alert modifiers (Odoo requires them in the arch) -->
                <xpath expr="//sheet" position="inside">
                    <field name="billing_actions_visible" invisible="1"/>
                    <field name="has_preauth_eligible_lines" invisible="1"/>
                    <field name="has_claim_submit_lines" invisible="1"/>
                    <field name="ampath_has_understock_lines" invisible="1"/>
                    <field name="ampath_has_prescription_hold" invisible="1"/>
                </xpath>

                <xpath expr="//sheet" position="before">
                    <div
                        class="alert alert-warning mb-3"
                        role="alert"
                        invisible="not ampath_has_understock_lines"
                    >
                        Some medications do not have enough stock to bill or claim yet.
                        Use <strong>Print prescription</strong> first: those lines are marked and
                        <strong>skipped on invoices and claims</strong> and
                        <strong>removed from delivery pickings</strong> until you clear the hold.
                        Other lines can still be invoiced or submitted to the payer.
                    </div>
                </xpath>

                <xpath expr="//header" position="inside">
                    <button name="action_waive_selected" type="object"
                            string="Waive selected"
                            class="btn-secondary"
                            invisible="not billing_actions_visible"
                            confirm="Apply a 100%% waiver discount to every selected line?"/>
                    <button name="action_request_preauth" type="object"
                            string="Preauth"
                            class="btn-secondary"
                            invisible="not billing_actions_visible or not has_preauth_eligible_lines"
                            confirm="Build SHA pre-authorization JSON for intervention-code lines on this order?"/>
                    <button name="action_submit_etl_claim_selected" type="object"
                            string="Submit claim"
                            class="btn-secondary"
                            invisible="not billing_actions_visible or not has_claim_submit_lines"
                            confirm="Submit all eligible PHC claim lines to AMPATH ETL as insurance payment (instead of cash)? Waived, prescription-hold, and out-of-stock lines are excluded."/>
                    <button name="action_invoice_selected" type="object"
                            string="Invoice selected"
                            class="btn-secondary"
                            invisible="not billing_actions_visible"
                            confirm="Create an invoice for every selected line?"/>
                    <button name="action_print_prescription" type="object"
                            string="Print prescription"
                            class="btn-secondary"
                            invisible="state == 'cancel'"/>
                    <button name="action_clear_prescription_invoice_hold" type="object"
                            string="Clear prescription hold"
                            class="btn-secondary"
                            invisible="not ampath_has_prescription_hold"
                            confirm="Medication lines will be included on invoices and delivery pickings again (subject to stock). Continue?"/>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="after">
                    <group string="Patient data" name="ampath_patient_data" colspan="2">
                        <field name="x_patient_uuid" readonly="1"/>
                        <field name="x_external_identifier" readonly="1"/>
                        <field name="x_customer_dob" readonly="1"/>
                        <field name="x_customer_weight" readonly="1"/>
                        <field name="x_patient_gender" readonly="1"/>
                    </group>
                </xpath>

                <!-- Row styling: muted+green = paid; blue = invoiced but unpaid -->
                <xpath expr="//field[@name='order_line']/tree" position="attributes">
                    <attribute name="decoration-muted">is_line_locked</attribute>
                    <attribute name="decoration-success">ampath_line_invoice_status == 'paid'</attribute>
                    <attribute name="decoration-info">ampath_line_invoice_status == 'invoiced'</attribute>
                </xpath>

                <!-- Extra columns added to the order lines tree -->
                <xpath expr="//field[@name='order_line']/tree" position="inside">

                    <!-- Hidden state fields used in expressions/readonly conditions -->
                    <field name="is_line_locked" column_invisible="1"/>
                    <field name="ampath_line_invoice_status" column_invisible="1"/>
                    <!-- is_downpayment must be explicitly loaded for the readonly expr below -->
                    <field name="is_downpayment" column_invisible="1"/>

                    <!-- Checkbox for bulk actions; readonly on DP/locked lines -->
                    <field name="selected"
                           widget="boolean_toggle"
                           optional="show"
                           readonly="is_downpayment or is_line_locked"/>

                    <!-- Per-line quick-invoice button (single line, no checkbox needed) -->
                    <button name="action_invoice_this_line"
                            type="object"
                            icon="fa-file-text-o"
                            title="Invoice this line"
                            class="btn-sm btn-link text-primary"
                            invisible="ampath_line_invoice_status != 'to_invoice' or is_downpayment or ampath_prescription_printed"/>

                    <!-- Invoice status icon: blank / 📄 / ✅ -->
                    <field name="invoice_indicator" string="Inv." readonly="1" optional="show"/>

                    <field name="is_claim_eligible" optional="show" readonly="1"/>
                    <field name="x_openmrs_order_id" optional="hide" readonly="1"/>
                    <field name="x_service_date_start" optional="hide"/>
                    <field name="x_service_date_end" optional="hide"/>
                    <field name="claim_status" widget="badge" optional="show"
                           decoration-info="claim_status == 'submitted'"
                           decoration-success="claim_status == 'approved'"/>

                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                    <field name="ampath_prescription_printed"
                           string="Rx printed"
                           optional="show"
                           readonly="1"/>
                </xpath>

                <!-- Lock price/qty/discount when the line's invoice is paid -->
                <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']"
                       position="attributes">
                    <attribute name="readonly">is_line_locked</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']"
                       position="attributes">
                    <attribute name="readonly">is_line_locked</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree//field[@name='discount']"
                       position="attributes">
                    <attribute name="readonly">is_line_locked</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
