<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_grn" model="ir.ui.view">
        <field name="name">stock.picking.form.grn</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Goods Receipt Note" invisible="picking_type_code != 'incoming'">
                    <group>
                        <field name="x_grn_number"/>
                        <field name="partner_id" string="Vendor"/>
                        <field name="x_delivery_number"/>
                        <field name="x_delivery_driver"/>
                    </group>
                    <group>
                        <field name="x_grn_document_ids" widget="many2many_binary" string="Documents"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
