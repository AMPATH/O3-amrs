<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ampath_vaccine_ledger_wizard_form" model="ir.ui.view">
        <field name="name">ampath.vaccine.ledger.wizard.form</field>
        <field name="model">ampath.vaccine.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Vaccine Stock Ledger">
                <header>
                    <button name="action_preview" type="object" string="Generate ledger"
                            class="btn-primary" invisible="state == 'preview'"/>
                    <button name="action_print_pdf" type="object" string="Download PDF"
                            class="btn-primary" invisible="state != 'preview'"/>
                    <button name="action_back_to_criteria" type="object" string="Back"
                            class="btn-secondary" invisible="state != 'preview'"/>
                    <field name="state" widget="statusbar" statusbar_visible="criteria,preview"/>
                </header>
                <sheet>
                    <field name="report_pdf_name" invisible="1"/>
                    <group string="Facility &amp; period" invisible="state == 'preview'">
                        <field name="company_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="product_id"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="state == 'preview'">
                        Builds the NVIP vaccine stock ledger from Vaccine Pickings
                        (receipts, issues to MCH, losses) with running balance.
                    </div>
                    <div invisible="state != 'preview'">
                        <div style="overflow-x: auto; max-width: 100%; border: 1px solid #dee2e6; background: #fff;">
                            <field name="preview_html" nolabel="1" readonly="1" colspan="2"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ampath_vaccine_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Vaccine Stock Ledger</field>
        <field name="res_model">ampath.vaccine.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_ampath_vaccine_ledger_wizard_form"/>
    </record>

    <menuitem id="menu_ampath_vaccine_ledger"
              name="Vaccine Stock Ledger"
              parent="menu_ampath_stock_vouchers"
              action="action_ampath_vaccine_ledger_wizard"
              sequence="50"/>
</odoo>
