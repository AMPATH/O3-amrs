<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Invoice form ── -->
    <record id="view_move_medical_form" model="ir.ui.view">
        <field name="name">account.move.form.medical</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">Patient</attribute>
            </field>
            <field name="invoice_user_id" position="attributes">
                <attribute name="string">Billing Officer</attribute>
            </field>
        </field>
    </record>

    <!-- ── Action renames ── -->
    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="name">Patient Invoices</field>
    </record>

    <record id="account.action_move_out_refund_type" model="ir.actions.act_window">
        <field name="name">Patient Credit Notes</field>
    </record>

    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="name">Supplier Bills</field>
    </record>

</odoo>
