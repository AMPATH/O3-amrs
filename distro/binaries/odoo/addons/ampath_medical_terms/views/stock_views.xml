<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Picking form ── -->
    <record id="view_picking_medical_form" model="ir.ui.view">
        <field name="name">stock.picking.form.medical</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">Patient</attribute>
            </field>
        </field>
    </record>

    <!-- ── Move line form ── -->
    <record id="view_move_line_medical_form" model="ir.ui.view">
        <field name="name">stock.move.line.form.medical</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="attributes">
                <attribute name="string">Batch/Serial Number</attribute>
            </field>
            <field name="lot_name" position="attributes">
                <attribute name="string">Batch/Serial Number</attribute>
            </field>
            <field name="product_id" position="attributes">
                <attribute name="string">Item</attribute>
            </field>
        </field>
    </record>

    <!-- ── Scrap form ── -->
    <record id="view_scrap_medical_form" model="ir.ui.view">
        <field name="name">stock.scrap.form.medical</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view2"/>
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="string">Item</attribute>
            </field>
            <field name="lot_id" position="attributes">
                <attribute name="string">Batch/Serial Number</attribute>
            </field>
        </field>
    </record>

    <!-- ── Lot/Serial Number form (using correct ID: view_production_lot_form) ── -->
    <record id="view_lot_medical_form" model="ir.ui.view">
        <field name="name">stock.lot.form.medical</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="string">Batch/Serial Number</attribute>
            </field>
            <field name="product_id" position="attributes">
                <attribute name="string">Item</attribute>
            </field>
        </field>
    </record>

    <!-- ── Reorder rules form ── -->
    <record id="view_orderpoint_medical_form" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.form.medical</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form"/>
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="string">Item</attribute>
            </field>
            <field name="warehouse_id" position="attributes">
                <attribute name="string">Medical Store</attribute>
            </field>
        </field>
    </record>

    <!-- ── Action renames ── -->
    <record id="stock.action_picking_tree_all" model="ir.actions.act_window">
        <field name="name">Stock Transfers</field>
    </record>

    <record id="stock.action_picking_tree_incoming" model="ir.actions.act_window">
        <field name="name">Goods Received Notes</field>
    </record>

    <record id="stock.action_picking_tree_outgoing" model="ir.actions.act_window">
        <field name="name">Dispensing Orders</field>
    </record>

    <record id="stock.action_picking_tree_internal" model="ir.actions.act_window">
        <field name="name">Internal Stock Transfers</field>
    </record>

    <record id="stock.action_stock_scrap" model="ir.actions.act_window">
        <field name="name">Wastage</field>
    </record>

    <record id="stock.action_orderpoint" model="ir.actions.act_window">
        <field name="name">Reorder Levels</field>
    </record>

    <record id="stock.action_production_lot_form" model="ir.actions.act_window">
        <field name="name">Batch/Serial Numbers</field>
    </record>

</odoo>
