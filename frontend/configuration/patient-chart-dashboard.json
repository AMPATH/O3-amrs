{
  "@openmrs/esm-patient-chart-app": {
    "extensionSlots": {
      "patient-chart-dashboard-slot": {
        "add": [
          "nav-group#GeneralMedicine",
          "nav-group#MNCH",
          "nav-group#ChronicDiseaseCentre",
          "nav-group#HTS"
        ],
        "order": [
          "nav-group#GeneralMedicine",
          "nav-group#MNCH",
          "nav-group#ChronicDiseaseCentre",
          "nav-group#HTS"
        ],
        "configure": {
          "billing-summary-dashboard-link":{
            "Display conditions": {
                "privileges": ["O3 View Patient Chart Billing History"]
            }
          },
          "nav-group#GeneralMedicine": {
            "Display conditions": {
               "privileges": ["O3 View General Medicine Tab"]
            },
            "title": "generalMedicine",
            "slotName": "general-medicine-group-slot",
            "isExpanded": true,
            "Translation overrides": {
              "en": {
                "generalMedicine": "General Medicine"
              }
            }
          },
          "nav-group#MNCH": {
            "Display conditions": {
               "privileges": ["O3 VIew MNCH Patient Chart Tab"]
            },
            "title": "mnch",
            "slotName": "mnch-group-slot",
            "isExpanded": true,
            "Translation overrides": {
              "en": {
                "mnch": "MNCH"
              }
            }
          },
          "nav-group#ChronicDiseaseCentre": {
            "Display conditions": {
               "privileges": ["O3 View CDC Patient Chart Tab"]
            },
            "title": "chronicDiseaseCentre",
            "slotName": "chronic-disease-centre-group-slot",
            "isExpanded": true,
            "Translation overrides": {
              "en": {
